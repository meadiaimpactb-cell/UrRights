# ── مطلوب ─────────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:3306/dbname
APP_SECRET=               # سلسلة طويلة عشوائية (32+ حرفًا) لتوقيع كوكي الجلسة
NODE_ENV=production
PORT=3000                 # الاستضافة عادةً تحدده تلقائيًا

# ── أول حساب مدير (يُنشأ تلقائيًا عند أول تشغيل إن لم يكن موجودًا) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=           # 8 أحرف على الأقل
ADMIN_NAME=

# ── اختياري ───────────────────────────────────────────────────
# AUTO_MIGRATE=false      # لتعطيل إنشاء الجداول والتعبئة التلقائية عند التشغيل
